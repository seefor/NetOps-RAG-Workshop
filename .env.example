# -----------------------------
# Provider selection
# -----------------------------
# LLM_PROVIDER options: ollama, openai, anthropic
LLM_PROVIDER=ollama

# EMBEDDINGS_PROVIDER options: ollama, openai
# Anthropic does not provide embeddings in this starter stack.
EMBEDDINGS_PROVIDER=ollama

# -----------------------------
# Ollama defaults
# -----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=embeddinggemma

# -----------------------------
# OpenAI options
# -----------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# -----------------------------
# Anthropic options
# -----------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# -----------------------------
# RAG settings
# -----------------------------
CHROMA_PATH=.chroma
COLLECTION_NAME=netops_knowledge
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
TEMPERATURE=0.1
MAX_TOKENS=1200
